{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/src/*": ["./src/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "vite.config.mts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "dist"]
}
